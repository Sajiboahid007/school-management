generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// 1. Roles
model Role {
  Id          Int       @id @default(autoincrement())
  Name        String    @unique
  Description String?

  Users       User[]
  Teachers    Teacher[]
  Students    Student[]

  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt
}

// 2. School Profile Information
model SchoolInformation {
  Id          Int      @id @default(autoincrement())
  Name        String
  Code        String   @unique
  Address     String
  Phone       String
  Email       String
  Website     String?
  LogoUrl     String?
  CurrentYear String   @default("2026")

  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt
}

// 3. Departments / Streams
model Department {
  Id          Int       @id @default(autoincrement())
  Name        String    @unique
  Code        String    @unique
  Description String?

  HeadId      Int?
  HeadTeacher Teacher?  @relation("DepartmentHead", fields: [HeadId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  Teachers    Teacher[] @relation("TeacherDepartment")
  Students    Student[] @relation("StudentDepartment")
  Subjects    Subject[]

  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt
}

// 4. Base Users (Admins, Super Admins, Staff)
model User {
  Id               Int            @id @default(autoincrement())
  Name             String
  Email            String         @unique
  Password         String
  Phone            String?

  RoleId           Int?
  Role             Role?          @relation(fields: [RoleId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  SentMessages     Message[]      @relation("SentUserMessages")
  ReceivedMessages Message[]      @relation("ReceivedUserMessages")
  Notifications    Notification[]

  CreatedAt        DateTime       @default(now())
  UpdatedAt        DateTime       @updatedAt

  @@index([RoleId])
}

// 5. Teachers
model Teacher {
  Id               Int             @id @default(autoincrement())
  Name             String
  Email            String          @unique
  Password         String
  Phone            String?
  Address          String?
  Gender           String?
  Qualification    String?
  JoiningDate      DateTime?

  RoleId           Int?
  Role             Role?           @relation(fields: [RoleId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  DepartmentId     Int?
  Department       Department?     @relation("TeacherDepartment", fields: [DepartmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  HeadedDepts      Department[]    @relation("DepartmentHead")

  ClassesTaught    Class[]         @relation("ClassTeacher")
  SubjectsTaught   Subject[]       @relation("TeacherSubject")
  Schedules        ClassSchedule[] @relation("TeacherSchedule")
  AttRecorded      Attendance[]    @relation("TeacherAttendance")
  ExamMarksEntered ExamsResult[]   @relation("TeacherExamMark")

  CreatedAt        DateTime        @default(now())
  UpdatedAt        DateTime        @updatedAt

  @@index([DepartmentId])
}

// 6. Students
model Student {
  Id           Int             @id @default(autoincrement())
  RollNumber   String?         @unique
  Name         String
  Email        String          @unique
  Password     String
  Phone        String?
  Address      String?
  Gender       String?
  DateOfBirth  DateTime?

  RoleId       Int?
  Role         Role?           @relation(fields: [RoleId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  ClassId      Int?
  Class        Class?          @relation("StudentClass", fields: [ClassId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  DepartmentId Int?
  Department   Department?     @relation("StudentDepartment", fields: [DepartmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  Admissions   Admission[]
  Attendances  Attendance[]
  ExamsResults ExamsResult[]
  Fees         FeeManagement[]

  CreatedAt    DateTime        @default(now())
  UpdatedAt    DateTime        @updatedAt

  @@index([ClassId])
  @@index([DepartmentId])
}

// 7. Classes
model Class {
  Id             Int             @id @default(autoincrement())
  Name           String
  Section        String
  RoomNumber     String?
  Capacity       Int             @default(40)

  ClassTeacherId Int?
  ClassTeacher   Teacher?        @relation("ClassTeacher", fields: [ClassTeacherId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  Students       Student[]       @relation("StudentClass")
  Subjects       Subject[]
  Schedules      ClassSchedule[]
  Attendances    Attendance[]
  Admissions     Admission[]

  CreatedAt      DateTime        @default(now())
  UpdatedAt      DateTime        @updatedAt

  @@unique([Name, Section])
}

// 8. Subjects
model Subject {
  Id           Int             @id @default(autoincrement())
  Name         String
  Code         String          @unique

  DepartmentId Int?
  Department   Department?     @relation(fields: [DepartmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  TeacherId    Int?
  Teacher      Teacher?        @relation("TeacherSubject", fields: [TeacherId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  ClassId      Int?
  Class        Class?          @relation(fields: [ClassId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  Schedules    ClassSchedule[]
  ExamsResults ExamsResult[]
  Attendances  Attendance[]

  CreatedAt    DateTime        @default(now())
  UpdatedAt    DateTime        @updatedAt
}

// 9. Class Schedules
model ClassSchedule {
  Id        Int      @id @default(autoincrement())
  ClassId   Int
  Class     Class    @relation(fields: [ClassId], references: [Id], onDelete: Cascade)
  SubjectId Int
  Subject   Subject  @relation(fields: [SubjectId], references: [Id], onDelete: Cascade)
  TeacherId Int
  Teacher   Teacher  @relation("TeacherSchedule", fields: [TeacherId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  DayOfWeek String
  StartTime String
  EndTime   String
  RoomNo    String?

  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  @@index([ClassId])
  @@index([TeacherId])
}

// 10. Admissions
model Admission {
  Id            Int      @id @default(autoincrement())
  ApplicationNo String   @unique
  StudentId     Int
  Student       Student  @relation(fields: [StudentId], references: [Id], onDelete: Cascade)
  ClassId       Int
  Class         Class    @relation(fields: [ClassId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  AcademicYear  String
  AdmissionDate DateTime @default(now())
  Status        String   @default("PENDING")

  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt
}

// 11. Attendance
model Attendance {
  Id                  Int      @id @default(autoincrement())
  Date                DateTime
  Status              String   @default("PRESENT")
  StudentId           Int
  Student             Student  @relation(fields: [StudentId], references: [Id], onDelete: Cascade)
  ClassId             Int
  Class               Class    @relation(fields: [ClassId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  SubjectId           Int?
  Subject             Subject? @relation(fields: [SubjectId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  RecordedByTeacherId Int
  RecordedByTeacher   Teacher  @relation("TeacherAttendance", fields: [RecordedByTeacherId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  CreatedAt           DateTime @default(now())
  UpdatedAt           DateTime @updatedAt

  @@index([Date, ClassId])
  @@index([StudentId])
}

// 12. Exams & Exam Results (Marks)
model Exam {
  Id           Int           @id @default(autoincrement())
  Title        String
  Term         String
  AcademicYear String
  StartDate    DateTime
  EndDate      DateTime

  ExamsResults ExamsResult[]

  CreatedAt    DateTime      @default(now())
  UpdatedAt    DateTime      @updatedAt
}

model ExamsResult {
  Id                  Int      @id @default(autoincrement())
  ExamId              Int
  Exam                Exam     @relation(fields: [ExamId], references: [Id], onDelete: Cascade)
  StudentId           Int
  Student             Student  @relation(fields: [StudentId], references: [Id], onDelete: Cascade)
  SubjectId           Int
  Subject             Subject  @relation(fields: [SubjectId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  RecordedByTeacherId Int?
  RecordedByTeacher   Teacher? @relation("TeacherExamMark", fields: [RecordedByTeacherId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  MarksObtained       Float
  TotalMarks          Float    @default(100)
  Grade               String?
  Remarks             String?

  CreatedAt           DateTime @default(now())
  UpdatedAt           DateTime @updatedAt

  @@unique([ExamId, StudentId, SubjectId])
}

// 13. Fee Management
model FeeManagement {
  Id            Int       @id @default(autoincrement())
  InvoiceNo     String    @unique
  StudentId     Int
  Student       Student   @relation(fields: [StudentId], references: [Id], onDelete: Cascade)
  FeeType       String    @default("TUITION")
  Amount        Float
  PaidAmount    Float     @default(0)
  DueDate       DateTime
  PaymentDate   DateTime?
  PaymentMethod String?
  Status        String    @default("UNPAID")

  CreatedAt     DateTime  @default(now())
  UpdatedAt     DateTime  @updatedAt

  @@index([StudentId])
  @@index([Status])
}

// 14. Messages
model Message {
  Id         Int      @id @default(autoincrement())
  SenderId   Int
  Sender     User     @relation("SentUserMessages", fields: [SenderId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  ReceiverId Int
  Receiver   User     @relation("ReceivedUserMessages", fields: [ReceiverId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Subject    String?
  Content    String
  IsRead     Boolean  @default(false)

  CreatedAt  DateTime @default(now())

  @@index([SenderId])
  @@index([ReceiverId])
}

// 15. Notifications
model Notification {
  Id        Int      @id @default(autoincrement())
  UserId    Int
  User      User     @relation(fields: [UserId], references: [Id], onDelete: Cascade)
  Title     String
  Message   String
  Type      String?
  IsRead    Boolean  @default(false)

  CreatedAt DateTime @default(now())

  @@index([UserId])
}
